function formatTime(sec){const m=String(Math.floor(sec/60)).padStart(2,'0'); const s=String(sec%60).padStart(2,'0'); return m+':'+s;}
function updateBackground(key){const body=document.body; body.classList.remove('bg-default','bg-electrocucion','bg-quemadura','bg-ahogamiento','bg-aplastamiento'); if(key==='electrocucion') body.classList.add('bg-electrocucion'); else if(key==='quemadura') body.classList.add('bg-quemadura'); else if(key==='ahogamiento') body.classList.add('bg-ahogamiento'); else if(key==='aplastamiento') body.classList.add('bg-aplastamiento'); else body.classList.add('bg-default'); updateAnimations(key);}
function show(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active')); document.getElementById(id).classList.add('active'); const tag=document.getElementById('groupTag'); if(tag) tag.textContent=state.group?('Grupo: '+state.group):'';}
function initAudio(){if(audioCtx) return; audioCtx = new (window.AudioContext||window.webkitAudioContext)(); masterGain = audioCtx.createGain(); masterGain.gain.value=0.6; masterGain.connect(audioCtx.destination); const bufferSize = audioCtx.sampleRate*2; const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate); const output = noiseBuffer.getChannelData(0); for(let i=0;i<bufferSize;i++) output[i]=Math.random()*2-1; windNode = audioCtx.createBufferSource(); windNode.buffer=noiseBuffer; windNode.loop=true; windFilter = audioCtx.createBiquadFilter(); windFilter.type='bandpass'; windFilter.frequency.value=400; windGain = audioCtx.createGain(); windGain.gain.value=0; windNode.connect(windFilter); windFilter.connect(windGain); windGain.connect(masterGain); windNode.start(); fireGain = audioCtx.createGain(); fireGain.gain.value=0; fireGain.connect(masterGain); rainGain = audioCtx.createGain(); rainGain.gain.value=0; rainGain.connect(masterGain);}
function playCrackle(){if(!audioCtx || isMuted || fireGain.gain.value<0.01) return; const t=audioCtx.currentTime; const burst=audioCtx.createBufferSource(); const len=audioCtx.sampleRate*0.15; const buf=audioCtx.createBuffer(1,len,audioCtx.sampleRate); const d=buf.getChannelData(0); for(let i=0;i<len;i++) d[i]=(Math.random()*2-1)*Math.pow(1-i/len,2); burst.buffer=buf; const f=audioCtx.createBiquadFilter(); f.type='highpass'; f.frequency.value=1800+Math.random()*3000; const g=audioCtx.createGain(); g.gain.setValueAtTime(0.8,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.2); burst.connect(f); f.connect(g); g.connect(fireGain); burst.start(t);}
function playThunder(isClose){if(!audioCtx || isMuted) return; const flash=document.getElementById('flash'); const soundDelay=isClose?0.12+Math.random()*0.25:0.8+Math.random()*1.6; flash.style.opacity=isClose?'0.92':'0.42'; setTimeout(()=>{flash.style.opacity='0.15'}, isClose?90:60); setTimeout(()=>{flash.style.opacity=isClose?'0.75':'0.25'}, isClose?140:110); setTimeout(()=>{flash.style.opacity='0'}, isClose?260:180); if(isClose){document.body.classList.add('shake'); setTimeout(()=>document.body.classList.remove('shake'),380);} const baseTime=audioCtx.currentTime+soundDelay; for(let k=0;k<2;k++){const osc=audioCtx.createOscillator(); const gain=audioCtx.createGain(); const filt=audioCtx.createBiquadFilter(); osc.type='sine'; const baseFreq=55+Math.random()*25 - k*12; osc.frequency.setValueAtTime(baseFreq, baseTime); osc.frequency.exponentialRampToValueAtTime(baseFreq*0.45, baseTime + (isClose?2.2:3.8) + Math.random()); filt.type='lowpass'; filt.frequency.setValueAtTime(isClose?220:160, baseTime); filt.Q.value=1; gain.gain.setValueAtTime(0, baseTime); gain.gain.linearRampToValueAtTime(isClose?0.85:0.48, baseTime+0.15); gain.gain.exponentialRampToValueAtTime(0.001, baseTime+5); osc.connect(filt); filt.connect(gain); gain.connect(masterGain); osc.start(baseTime); osc.stop(baseTime+6);} {const dur=isClose?2.8:4.2; const len=Math.floor(audioCtx.sampleRate*dur); const buf=audioCtx.createBuffer(1,len,audioCtx.sampleRate); const ch=buf.getChannelData(0); let last=0; for(let i=0;i<len;i++){const white=Math.random()*2-1; last=(last*0.97 + white*0.03); const env=Math.exp(-i/(audioCtx.sampleRate* (isClose?1.1:1.9))); ch[i]=last*env*1.8;} const src=audioCtx.createBufferSource(); src.buffer=buf; const bp=audioCtx.createBiquadFilter(); bp.type='bandpass'; bp.frequency.value=110; bp.Q.value=0.9; const lp=audioCtx.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=280; const g=audioCtx.createGain(); g.gain.value=isClose?0.72:0.40; src.connect(bp); bp.connect(lp); lp.connect(g); g.connect(masterGain); src.start(baseTime);} if(isClose){const crackLen=0.28; const cLen=Math.floor(audioCtx.sampleRate*crackLen); const cBuf=audioCtx.createBuffer(1,cLen,audioCtx.sampleRate); const cCh=cBuf.getChannelData(0); for(let i=0;i<cLen;i++){const t=i/audioCtx.sampleRate; const impulse=i<20 ? (Math.random()*2-1)*(1 - i/20) : 0; const noise=(Math.random()*2-1)*Math.exp(-t*28)*0.7; cCh[i]=(impulse*1.8 + noise);} const cSrc=audioCtx.createBufferSource(); cSrc.buffer=cBuf; const hp1=audioCtx.createBiquadFilter(); hp1.type='highpass'; hp1.frequency.value=1200; const cg=audioCtx.createGain(); cg.gain.setValueAtTime(1.0, baseTime); cg.gain.exponentialRampToValueAtTime(0.001, baseTime+0.45); cSrc.connect(hp1); hp1.connect(cg); cg.connect(masterGain); cSrc.start(baseTime);}}
function startRainLoop(intensity){if(!audioCtx) return; rainNodes.forEach(n=>{try{n.stop()}catch(e){}}); rainNodes=[]; if(intensity<=0){rainGain.gain.value=0; return;} rainGain.gain.value=intensity*0.35; for(let k=0;k<3;k++){const buf=audioCtx.createBuffer(1, audioCtx.sampleRate*1.5, audioCtx.sampleRate); const d=buf.getChannelData(0); for(let i=0;i<d.length;i++) d[i]=(Math.random()*2-1)*0.6; const src=audioCtx.createBufferSource(); src.buffer=buf; src.loop=true; const bp=audioCtx.createBiquadFilter(); bp.type='bandpass'; bp.frequency.value=2500 + k*800; bp.Q.value=0.8; const g=audioCtx.createGain(); g.gain.value=0.25; src.connect(bp); bp.connect(g); g.connect(rainGain); src.start(audioCtx.currentTime + k*0.1); rainNodes.push(src);}}
function setSoundscape(type){if(!audioCtx) return; currentSoundscape=type; const t=audioCtx.currentTime; clearInterval(thunderTimer); clearInterval(fireCrackleTimer); windGain.gain.cancelScheduledValues(t); fireGain.gain.cancelScheduledValues(t); rainGain.gain.cancelScheduledValues(t); const pulse=document.getElementById('pulse'); const label=document.getElementById('ambientText'); const fireGlow=document.getElementById('fireGlow'); if(type==='storm'){windFilter.frequency.linearRampToValueAtTime(550,t+1); windGain.gain.linearRampToValueAtTime(0.22,t+1.2); startRainLoop(0.9); fireGain.gain.linearRampToValueAtTime(0,t+0.5); if(fireGlow) fireGlow.style.opacity='0'; if(label) label.textContent='tormenta eléctrica ⛈️'; if(pulse) pulse.className='pulse'; thunderTimer=setInterval(()=>{playThunder(Math.random()>0.4);}, 3500+Math.random()*4500); setTimeout(()=>playThunder(true),800);} else if(type==='fire'){windFilter.frequency.linearRampToValueAtTime(300,t+1); windGain.gain.linearRampToValueAtTime(0.08,t+1); startRainLoop(0); fireGain.gain.linearRampToValueAtTime(0.55,t+0.8); if(fireGlow) fireGlow.style.opacity='1'; if(label) label.textContent='incendio crepitante 🔥'; if(pulse) pulse.className='pulse'; fireCrackleTimer=setInterval(playCrackle, 120+Math.random()*250);} else if(type==='flood'){windFilter.frequency.linearRampToValueAtTime(700,t+1); windGain.gain.linearRampToValueAtTime(0.30,t+1); startRainLoop(1.3); fireGain.gain.linearRampToValueAtTime(0,t+0.5); if(fireGlow) fireGlow.style.opacity='0'; if(label) label.textContent='inundación y lluvia 🌊'; if(pulse) pulse.className='pulse'; thunderTimer=setInterval(()=>{playThunder(Math.random()>0.7);}, 5000+Math.random()*5000);} else if(type==='collapse'){windFilter.frequency.linearRampToValueAtTime(180,t+1.2); windGain.gain.linearRampToValueAtTime(0.18,t+1.2); startRainLoop(0.15); fireGain.gain.linearRampToValueAtTime(0,t+0.5); if(fireGlow) fireGlow.style.opacity='0.15'; if(label) label.textContent='derrumbe y polvo 🏚️'; if(pulse) pulse.className='pulse';} else{windGain.gain.linearRampToValueAtTime(0.05,t+0.8); startRainLoop(0.1); fireGain.gain.linearRampToValueAtTime(0,t+0.5); if(fireGlow) fireGlow.style.opacity='0'; if(label) label.textContent='ambiente tenso'; if(pulse) pulse.className='pulse';}}
function startAudioExperience(){initAudio(); document.getElementById('audioGate').style.display='none'; const btn=document.getElementById('soundToggle'); if(btn) btn.textContent='🔊'; const pulse=document.getElementById('pulse'); if(pulse) pulse.className='pulse'; setSoundscape('storm'); initAllAnimations();}
function startWithoutAudio(){document.getElementById('audioGate').style.display='none'; const at=document.getElementById('ambientText'); if(at) at.textContent='silenciado'; const p=document.getElementById('pulse'); if(p) p.className='pulse off'; const b=document.getElementById('soundToggle'); if(b) b.textContent='🔇'; isMuted=true; initAllAnimations();}
function toggleMute(){if(!audioCtx){initAudio();} isMuted=!isMuted; const btn=document.getElementById('soundToggle'); const pulse=document.getElementById('pulse'); const label=document.getElementById('ambientText'); if(isMuted){masterGain.gain.value=0; if(btn){btn.textContent='🔇'; btn.classList.add('muted');} if(pulse) pulse.className='pulse off'; if(label) label.textContent='silenciado';} else {masterGain.gain.value=parseFloat(document.getElementById('vol').value||0.6); if(btn){btn.textContent='🔊'; btn.classList.remove('muted');} if(pulse) pulse.className='pulse'; if(label) label.textContent=currentSoundscape||'activo'; if(!currentSoundscape) setSoundscape('storm');}}
function setVolume(v){if(masterGain) masterGain.gain.value=v;}
function initAllAnimations(){setupWindCanvas(); setupRainCanvas(); setupFireCanvas(); setupDebrisCanvas(); setupLightningCanvas(); updateAnimations(null);}
function updateAnimations(key){animState.current=key; document.querySelectorAll('#windCanvas,#rainCanvas,#fireCanvas,#debrisCanvas,#lightningCanvas').forEach(c=>c.style.opacity='0'); if(!key){document.getElementById('windCanvas').style.opacity='0.35'; return;} if(key==='electrocucion'){document.getElementById('lightningCanvas').style.opacity='1'; document.getElementById('windCanvas').style.opacity='0.25'; document.getElementById('rainCanvas').style.opacity='0.6';} else if(key==='quemadura'){document.getElementById('fireCanvas').style.opacity='1';} else if(key==='ahogamiento'){document.getElementById('rainCanvas').style.opacity='1';} else if(key==='aplastamiento'){document.getElementById('debrisCanvas').style.opacity='1';}}
function setupWindCanvas(){const c=document.getElementById('windCanvas'); if(!c) return; const ctx=c.getContext('2d'); function resize(){c.width=innerWidth; c.height=innerHeight;} resize(); window.addEventListener('resize',resize); const particles=[]; for(let i=0;i<70;i++) particles.push({x:Math.random()*c.width, y:Math.random()*c.height, vx:2+Math.random()*5}); function anim(){ctx.clearRect(0,0,c.width,c.height); ctx.strokeStyle='rgba(180,210,255,0.18)'; ctx.lineWidth=1; for(let p of particles){ctx.beginPath(); ctx.moveTo(p.x,p.y); ctx.lineTo(p.x-p.vx*9, p.y); ctx.stroke(); p.x+=p.vx; if(p.x>c.width+20){p.x=-20; p.y=Math.random()*c.height;}} requestAnimationFrame(anim);} anim();}
function setupRainCanvas(){const c=document.getElementById('rainCanvas'); if(!c) return; const ctx=c.getContext('2d'); function resize(){c.width=innerWidth; c.height=innerHeight;} resize(); const drops=[]; for(let i=0;i<220;i++) drops.push({x:Math.random()*c.width, y:Math.random()*c.height, l:8+Math.random()*16, v:6+Math.random()*12}); function anim(){ctx.clearRect(0,0,c.width,c.height); ctx.strokeStyle='rgba(170,195,230,0.32)'; ctx.lineWidth=1; for(let d of drops){ctx.beginPath(); ctx.moveTo(d.x,d.y); ctx.lineTo(d.x-2, d.y+d.l); ctx.stroke(); d.y+=d.v; d.x-=1.2; if(d.y>c.height){d.y=-20; d.x=Math.random()*c.width;}} requestAnimationFrame(anim);} anim();}
function setupFireCanvas(){const c=document.getElementById('fireCanvas'); if(!c) return; const ctx=c.getContext('2d'); function resize(){c.width=innerWidth; c.height=innerHeight;} resize(); const particles=[]; function spawn(){return {x:Math.random()*c.width, y:c.height+Math.random()*40, vx:(Math.random()-0.5)*2.5, vy:-(2+Math.random()*6), size:2+Math.random()*7, life:0, maxLife:60+Math.random()*80, hue: 8+Math.random()*28};} for(let i=0;i<140;i++) particles.push(spawn()); function anim(){ctx.clearRect(0,0,c.width,c.height); for(let p of particles){p.x+=p.vx + Math.sin(p.life*0.08)*0.6; p.y+=p.vy; p.vy+= -0.02; p.life++; const alpha=1-p.life/p.maxLife; if(alpha<=0){Object.assign(p, spawn()); continue;} const grad=ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.size*2.5); grad.addColorStop(0,'hsla('+p.hue+', 100%, 62%, '+alpha+')'); grad.addColorStop(0.4,'hsla('+(p.hue+8)+', 98%, 52%, '+(alpha*0.6)+')'); grad.addColorStop(1,'hsla('+(p.hue+18)+', 95%, 40%, 0)'); ctx.fillStyle=grad; ctx.beginPath(); ctx.arc(p.x,p.y,p.size,0,Math.PI*2); ctx.fill();} requestAnimationFrame(anim);} anim();}
function setupDebrisCanvas(){const c=document.getElementById('debrisCanvas'); if(!c) return; const ctx=c.getContext('2d'); function resize(){c.width=innerWidth; c.height=innerHeight;} resize(); const debris=[]; function spawn(){return {x:Math.random()*c.width, y:-20 - Math.random()*200, vx:(Math.random()-0.5)*1.5, vy:0.8+Math.random()*2.2, size:2+Math.random()*10, rot:Math.random()*Math.PI*2, rotV:(Math.random()-0.5)*0.08, gray: 90+Math.random()*80};} for(let i=0;i<85;i++) debris.push(spawn()); function anim(){ctx.clearRect(0,0,c.width,c.height); for(let d of debris){d.x+=d.vx; d.y+=d.vy; d.vy+=0.02; d.rot+=d.rotV; if(d.y>c.height+30){Object.assign(d, spawn());} ctx.save(); ctx.translate(d.x,d.y); ctx.rotate(d.rot); ctx.fillStyle='rgb('+d.gray+','+(d.gray-6)+','+(d.gray-12)+')'; ctx.fillRect(-d.size/2,-d.size/2,d.size,d.size*0.7); ctx.restore();} requestAnimationFrame(anim);} anim();}
function setupLightningCanvas(){const c=document.getElementById('lightningCanvas'); if(!c) return; const ctx=c.getContext('2d'); function resize(){c.width=innerWidth; c.height=innerHeight;} resize(); window.addEventListener('resize',resize); let bolts=[]; let lastBolt=0; function createBolt(){const startX=c.width*0.2+Math.random()*c.width*0.6; let x=startX, y=0; const segs=[]; while(y<c.height*0.75){const nx=x+(Math.random()-0.5)*34; const ny=y+12+Math.random()*28; segs.push({x:x,y:y,nx:nx,ny:ny}); x=nx; y=ny;} bolts.push({segs:segs, life:0, maxLife:6+Math.random()*8});} function anim(now){ctx.clearRect(0,0,c.width,c.height); if(now-lastBolt>900+Math.random()*2200 && animState.current==='electrocucion'){createBolt(); lastBolt=now;} for(let i=bolts.length-1;i>=0;i--){const bolt=bolts[i]; bolt.life++; const alpha=1-bolt.life/bolt.maxLife; if(alpha<=0){bolts.splice(i,1); continue;} ctx.strokeStyle='rgba(160,220,255,'+(alpha*0.9)+')'; ctx.lineWidth=2.2*alpha+0.5; ctx.shadowColor='#7ecbff'; ctx.shadowBlur=12*alpha; ctx.beginPath(); for(let s of bolt.segs){ctx.moveTo(s.x,s.y); ctx.lineTo(s.nx,s.ny);} ctx.stroke(); ctx.strokeStyle='rgba(255,255,255,'+alpha+')'; ctx.lineWidth=1*alpha; ctx.shadowBlur=0; ctx.beginPath(); for(let s of bolt.segs){ctx.moveTo(s.x,s.y); ctx.lineTo(s.nx,s.ny);} ctx.stroke();} requestAnimationFrame(anim);} requestAnimationFrame(anim);}
function launchCelebration(isChampion){const canvas=document.getElementById('confettiCanvas'); if(!canvas) return; const ctx=canvas.getContext('2d'); canvas.width=innerWidth; canvas.height=innerHeight; canvas.classList.add('active'); const pieces=[]; const colors=['#00B7EB','#FFD23F','#FF6B6B','#4ECDC4','#FF9F1C','#2ECC71','#FFFFFF']; const count=isChampion?220:90; for(let i=0;i<count;i++){pieces.push({x:Math.random()*canvas.width, y:-20 - Math.random()*canvas.height*0.5, vx:(Math.random()-0.5)*6, vy:2+Math.random()*5, size:5+Math.random()*8, color:colors[Math.floor(Math.random()*colors.length)], rot:Math.random()*360, rotV:(Math.random()-0.5)*12});} function anim(){ctx.clearRect(0,0,canvas.width,canvas.height); for(let p of pieces){p.x+=p.vx; p.y+=p.vy; p.vy+=0.08; p.rot+=p.rotV; ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.rot*Math.PI/180); ctx.fillStyle=p.color; ctx.fillRect(-p.size/2,-p.size/2,p.size,p.size*0.6); ctx.restore();} if(pieces.some(p=>p.y<canvas.height+50)){confettiAnimId=requestAnimationFrame(anim);} else {canvas.classList.remove('active');}} anim(); if(isChampion) playApplause();}
function playApplause(){if(!audioCtx || isMuted) return; const now=audioCtx.currentTime; for(let i=0;i<22;i++){const t=now + i*0.11 + Math.random()*0.06; const buf=audioCtx.createBuffer(1, Math.floor(audioCtx.sampleRate*0.12), audioCtx.sampleRate); const ch=buf.getChannelData(0); for(let j=0;j<ch.length;j++) ch[j]=(Math.random()*2-1)*Math.pow(1-j/ch.length,1.8)*0.9; const src=audioCtx.createBufferSource(); src.buffer=buf; const bp=audioCtx.createBiquadFilter(); bp.type='bandpass'; bp.frequency.value=1200+Math.random()*1800; bp.Q.value=0.9; const g=audioCtx.createGain(); g.gain.setValueAtTime(0,t); g.gain.linearRampToValueAtTime(0.5+Math.random()*0.3,t+0.01); g.gain.exponentialRampToValueAtTime(0.001,t+0.22); src.connect(bp); bp.connect(g); g.connect(masterGain); src.start(t);}}
function startSetup(){const val=document.getElementById('groupName').value.trim(); const err=document.getElementById('setupError'); if(!val){err.textContent="Ingresen un nombre o número de grupo antes de continuar."; return;} err.textContent=""; state.group=val; renderScenarioGrid(); show('screen-pick'); if(audioCtx && !isMuted) setSoundscape('storm');}
function renderScenarioGrid(){const grid=document.getElementById('scenarioGrid'); grid.innerHTML=""; const bgMap={"electrocucion": "", "quemadura": "", "ahogamiento": "", "aplastamiento": ""}; Object.keys(SCENARIOS).forEach(key=>{const sc=SCENARIOS[key]; const div=document.createElement('div'); div.className='scenario-card has-bg'; div.style.backgroundImage="url('data:image/webp;base64,"+bgMap[key]+"')"; div.innerHTML='<div class="icon">'+sc.icon+'</div><div class="tag">'+sc.tag+'</div><div class="name">'+sc.name+'</div><div style="position:relative; z-index:1; font-size:11px; opacity:.85; margin-top:4px;">'+(sc.sound==='fire'?'🔥 FUEGO':sc.sound==='storm'?'⚡ RAYOS':sc.sound==='flood'?'🌊 LLUVIA':'🏚️ ESCOMBROS')+'</div>'; div.onclick=()=>pickScenario(key); grid.appendChild(div);});}
function pickRandom(){const keys=Object.keys(SCENARIOS); pickScenario(keys[Math.floor(Math.random()*keys.length)]);}
function pickScenario(key){
  state.scenarioKey=key; 
  updateBackground(key); 
  // Mostrar instrucciones
  const sc=SCENARIOS[key];
  document.getElementById('instrTitle').textContent=sc.icon+' '+sc.name+' - Instrucciones';
  document.getElementById('instrScenarioName').textContent=sc.tag+' · '+sc.name;
  document.getElementById('instrScenarioDesc').textContent=sc.scene;
  show('screen-instructions');
  if(audioCtx && !isMuted){setSoundscape(sc.sound); if(sc.sound==='storm') setTimeout(()=>playThunder(true),400);}
}
function startStation(){
  goSequence();
}

function goSequence(){const sc=SCENARIOS[state.scenarioKey]; state.pool=[...sc.correct, ...sc.distractors].sort(()=>Math.random()-0.5); state.sequence=[]; const ri=document.getElementById('reminderIcon'); if(ri) ri.textContent=sc.icon; const rt=document.getElementById('reminderTag'); if(rt) rt.textContent=sc.tag+' · '+sc.name; const rtxt=document.getElementById('reminderText'); if(rtxt) rtxt.textContent=sc.scene; renderSequenceScreen(); show('screen-sequence'); startTimer();}
function renderSequenceScreen(){
  const poolDiv=document.getElementById('pool'); poolDiv.innerHTML="";
  state.pool.forEach(text=>{if(state.sequence.includes(text)) return; const div=document.createElement('div'); div.className='action-card'; div.innerHTML='<div class="num">+</div><div>'+text+'</div>'; div.onclick=()=>addToSequence(text); poolDiv.appendChild(div);});
  const seqDiv=document.getElementById('seqList');
  if(state.sequence.length===0){
    seqDiv.innerHTML='<div class="seq-empty">Todavía no eligieron ninguna acción<br><small style="opacity:.7">Tocá abajo para agregar. Luego arrastrá ☰ para reordenar.</small></div>';
  } else {
    seqDiv.innerHTML="";
    state.sequence.forEach((text,i)=>{
      const div=document.createElement('div'); div.className='seq-item'; div.draggable=true; div.dataset.idx=i;
      div.innerHTML='<span>☰</span><div class="num">'+(i+1)+'</div><div style="flex:1;">'+text+'</div><span style="opacity:.6; font-size:12px;">✕</span>';
      let wasDrag=false;
      div.addEventListener('click', (e)=>{ if(wasDrag){wasDrag=false; return;} removeFromSequence(text); });
      div.addEventListener('dragstart', (e)=>{draggedIdx=i; wasDrag=true; div.classList.add('dragging'); e.dataTransfer.effectAllowed='move'; e.dataTransfer.setData('text/plain', i);});
      div.addEventListener('dragend', ()=>{div.classList.remove('dragging'); seqDiv.querySelectorAll('.seq-item').forEach(el=>el.classList.remove('drag-over')); draggedIdx=null;});
      div.addEventListener('dragover', (e)=>{e.preventDefault(); div.classList.add('drag-over');});
      div.addEventListener('dragleave', ()=>{div.classList.remove('drag-over');});
      div.addEventListener('drop', (e)=>{e.preventDefault(); div.classList.remove('drag-over'); const from=draggedIdx!==null?draggedIdx:parseInt(e.dataTransfer.getData('text/plain')); const to=i; if(from!==null && from!==to) reorderSequence(from,to);});
      div.addEventListener('touchstart', ()=>{draggedIdx=i; div.classList.add('dragging');}, {passive:true});
      div.addEventListener('touchmove', (e)=>{wasDrag=true; const touch=e.touches[0]; const el=document.elementFromPoint(touch.clientX,touch.clientY); const target=el?el.closest('.seq-item'):null; seqDiv.querySelectorAll('.seq-item').forEach(el=>el.classList.remove('drag-over')); if(target && target!==div) target.classList.add('drag-over');}, {passive:true});
      div.addEventListener('touchend', (e)=>{const touch=e.changedTouches[0]; const el=document.elementFromPoint(touch.clientX,touch.clientY); const target=el?el.closest('.seq-item'):null; if(target){const to=parseInt(target.dataset.idx); if(draggedIdx!==null && to!==draggedIdx) reorderSequence(draggedIdx,to);} div.classList.remove('dragging'); seqDiv.querySelectorAll('.seq-item').forEach(el=>el.classList.remove('drag-over')); draggedIdx=null; setTimeout(()=>wasDrag=false,200);});
      seqDiv.appendChild(div);
    });
    const hint=document.createElement('div'); hint.style.cssText='font-size:11px; color:#8AA0B8; text-align:center; margin-top:8px; opacity:0.8;'; hint.textContent='↕ Mantené ☰ y arrastrá para reordenar · Tocá para quitar'; seqDiv.appendChild(hint);
  }
}
function reorderSequence(from,to){if(from===to) return; const item=state.sequence.splice(from,1)[0]; state.sequence.splice(to,0,item); renderSequenceScreen(); if(navigator.vibrate) navigator.vibrate(30);}
function addToSequence(text){state.sequence.push(text); document.getElementById('seqError').textContent=""; renderSequenceScreen(); if(audioCtx && !isMuted && Math.random()>0.6) playCrackle();}
function removeFromSequence(text){state.sequence = state.sequence.filter(t=>t!==text); renderSequenceScreen();}
function lcs(a,b){const m=a.length,n=b.length; const dp=Array.from({length:m+1},()=>new Array(n+1).fill(0)); for(let i=1;i<=m;i++){for(let j=1;j<=n;j++){if(a[i-1]===b[j-1]) dp[i][j]=dp[i-1][j-1]+1; else dp[i][j]=Math.max(dp[i-1][j],dp[i][j-1]);}} return dp[m][n];}
function confirmSequence(){
  if(state.sequence.length===0){document.getElementById('seqError').textContent="Elijan al menos una acción antes de confirmar."; return;}
  const sc=SCENARIOS[state.scenarioKey]; 
  const correctSet=new Set(sc.correct); 
  const chosenCorrectOnly=state.sequence.filter(t=>correctSet.has(t)); 
  const distractorsChosen=state.sequence.filter(t=>!correctSet.has(t));
  const orderScore=lcs(chosenCorrectOnly, sc.correct);
  let score=Math.round((orderScore/sc.correct.length)*80); 
  score-=distractorsChosen.length*10; 
  if(distractorsChosen.length===0 && orderScore===sc.correct.length) score+=20; 
  score=Math.max(0,Math.min(100,score));
  document.getElementById('scoreNum').textContent=score;
  
  const feedbackList=document.getElementById('feedbackList'); 
  feedbackList.innerHTML="";
  
  // Crear grid de comparación
  const grid=document.createElement('div');
  grid.className='compare-grid';
  
  // Columna izquierda: Tu secuencia
  const colPlayer=document.createElement('div');
  colPlayer.className='compare-col player';
  colPlayer.innerHTML='<h4>👥 Tu secuencia ('+state.sequence.length+' pasos)</h4>';
  
  state.sequence.forEach((step, idx)=>{
    const isCorrect = correctSet.has(step);
    const correctIdx = sc.correct.indexOf(step);
    const isPositionOk = correctIdx===idx && isCorrect;
    const isDistractor = !isCorrect;
    
    const item=document.createElement('div');
    item.className='compare-item '+(isDistractor?'bad':(isPositionOk?'ok':'bad'));
    
    let badge='';
    if(isDistractor) badge='<span class="compare-badge badge-bad">DISTRACTOR -10</span>';
    else if(isPositionOk) badge='<span class="compare-badge badge-ok">✓ POSICIÓN CORRECTA</span>';
    else if(isCorrect) badge='<span class="compare-badge badge-warn">✓ CORRECTA pero fuera de orden (está en pos '+(correctIdx+1)+')</span>';
    
    item.innerHTML='<div class="cNum">'+(idx+1)+'</div><div style="flex:1;"><div>'+step+'</div><div style="margin-top:4px;">'+badge+'</div></div>';
    colPlayer.appendChild(item);
  });
  
  if(distractorsChosen.length>0){
    const warn=document.createElement('div');
    warn.style.cssText='margin-top:10px; background:#FDEDEC; border-radius:8px; padding:8px; font-size:12px; color:#C0392B;';
    warn.innerHTML='⚠️ Elegiste '+distractorsChosen.length+' acción(es) incorrecta(s) que restan 10 pts cada una';
    colPlayer.appendChild(warn);
  }
  
  // Columna derecha: Secuencia ideal
  const colCorrect=document.createElement('div');
  colCorrect.className='compare-col correct';
  colCorrect.innerHTML='<h4>✅ Secuencia ideal ('+sc.correct.length+' pasos)</h4>';
  
  sc.correct.forEach((step, idx)=>{
    const wasChosen = state.sequence.includes(step);
    const playerIdx = state.sequence.indexOf(step);
    const isPositionOk = playerIdx===idx;
    
    const item=document.createElement('div');
    if(!wasChosen) item.className='compare-item missing';
    else if(isPositionOk) item.className='compare-item ok';
    else item.className='compare-item bad';
    
    let status='';
    if(!wasChosen) status='<span class="compare-badge badge-bad">✕ NO LA ELEGISTE</span>';
    else if(isPositionOk) status='<span class="compare-badge badge-ok">✓ La hiciste bien</span>';
    else status='<span class="compare-badge badge-warn">La elegiste en pos '+(playerIdx+1)+' en vez de '+(idx+1)+'</span>';
    
    const explain = sc.explain && sc.explain[step] ? '<div style="font-size:11px; color:#5A6472; margin-top:4px;">💡 '+sc.explain[step]+'</div>' : '';
    
    item.innerHTML='<div class="cNum">'+(idx+1)+'</div><div style="flex:1;"><div>'+step+'</div>'+explain+'<div style="margin-top:4px;">'+status+'</div></div>';
    colCorrect.appendChild(item);
  });
  
  grid.appendChild(colPlayer);
  grid.appendChild(colCorrect);
  
  feedbackList.appendChild(grid);
  
  // Resumen de cálculo
  const summary=document.createElement('div');
  summary.style.cssText='margin-top:16px; background:#1B2A4A; color:white; border-radius:12px; padding:14px; font-size:13px;';
  summary.innerHTML='<div style="font-weight:800; margin-bottom:6px;">📊 Cómo se calculó tu puntaje:</div>'+
    '<div>• Orden correcto (LCS): '+orderScore+'/'+sc.correct.length+' → '+(Math.round((orderScore/sc.correct.length)*80))+' pts de 80</div>'+
    '<div>• Distractores: '+distractorsChosen.length+' × -10 = -'+(distractorsChosen.length*10)+' pts</div>'+
    '<div>• Bonus perfección: '+(distractorsChosen.length===0 && orderScore===sc.correct.length ? '+20 pts' : '0 pts')+'</div>'+
    '<div style="margin-top:6px; font-weight:800; font-size:16px;">Total: '+score+' / 100</div>';
  feedbackList.appendChild(summary);
  
  state.lastScore=score; 
  state.lastSequence=[...state.sequence];
  stopTimer(); 
  const tEl=document.getElementById('resultTime'); 
  if(tEl) tEl.textContent=formatTime(state.elapsedSec); 
  show('screen-score');
  if(audioCtx && !isMuted){if(score>=80) windGain.gain.linearRampToValueAtTime(0.02, audioCtx.currentTime+0.5); else playThunder(score<50);}
}
function saveScore(){const sc=SCENARIOS[state.scenarioKey]; state.board.push({group:state.group, score:state.lastScore, escenario:sc.name, escenarioKey:state.scenarioKey, timeSec:state.elapsedSec, timeStr:formatTime(state.elapsedSec)}); nextGroup();}
function nextGroup(){stopTimer(); state.group=""; state.scenarioKey=null; state.sequence=[]; state.elapsedSec=0; const inp=document.getElementById('groupName'); if(inp) inp.value=""; const se=document.getElementById('setupError'); if(se) se.textContent=""; const el=document.getElementById('timerTime'); if(el) el.textContent='00:00'; updateBackground(null); show('screen-setup'); if(audioCtx && !isMuted) setSoundscape('storm');}
function showBoard(){const list=document.getElementById('boardList'); const sorted=[...state.board].sort((a,b)=>b.score-a.score); if(sorted.length===0){list.innerHTML='<p style="color:#5A6472;">Todavía no hay puntajes guardados.</p>';} else {list.innerHTML=""; const maxScore=sorted[0].score; sorted.forEach(item=>{const isTop=item.score===maxScore; const trophy=isTop?'<span class="trophy">🏆</span>':''; const row=document.createElement('div'); row.className='board-row'+(isTop?' champion-row':''); const timeLabel=item.timeStr?'<span style="color:#2E8B8B; font-size:12px; margin-left:6px;">⏱ '+item.timeStr+'</span>':''; row.innerHTML='<div><span style="font-weight:700;">'+item.group+timeLabel+trophy+'</span><div style="color:#5A6472; font-size:12px;">'+item.escenario+(isTop?' · ¡LÍDER!':'')+'</div></div><div style="display:flex; gap:6px; align-items:center;"><div style="font-weight:800; color:#00B7EB;">'+item.score+'</div><button class="btn small teal" style="padding:6px 10px; font-size:11px;" onclick="generateDiplomaFor(\''+item.group.replace(/'/g,"\\'")+'\',\''+item.escenario.replace(/'/g,"\\'")+'\',\''+item.escenarioKey+'\','+item.score+',\''+item.timeStr+'\')">📜 Diploma</button></div>'; list.appendChild(row);});} show('screen-board');}
function backFromBoard(){show('screen-setup');}
function generateDiplomaFor(groupName, escenarioName, escenarioKey, score, timeStr){
  const maxScore = state.board.length ? Math.max(...state.board.map(b=>b.score), score) : score;
  const isChampion = score >= maxScore;
  const canvas=document.getElementById('diplomaCanvas'); const ctx=canvas.getContext('2d');
  const W=canvas.width, H=canvas.height;
  const grad=ctx.createLinearGradient(0,0,W,H); grad.addColorStop(0,'#FFFDF6'); grad.addColorStop(1,'#FFECD1'); ctx.fillStyle=grad; ctx.fillRect(0,0,W,H);
  ctx.strokeStyle='#00B7EB'; ctx.lineWidth=8; ctx.strokeRect(14,14,W-28,H-28);
  ctx.strokeStyle='#1B2A4A'; ctx.lineWidth=2; ctx.strokeRect(28,28,W-56,H-56);
  try{ if(personalLogoImg.complete){ ctx.drawImage(personalLogoImg, 60, 45, 110, 36); } }catch(e){}
  ctx.fillStyle='#1B2A4A'; ctx.font='900 26px sans-serif'; ctx.fillText('SALUD OCUPACIONAL LITORAL', 190, 90);
  ctx.fillStyle='#2E8B8B'; ctx.font='700 18px sans-serif'; ctx.fillText('Be Safe · Corrientes 2026', 60, 120);
  ctx.fillStyle='#00B7EB'; ctx.font='700 13px sans-serif'; ctx.fillText('JORNADA DE TRAUMA EN CATASTROFES AMBIENTALES', 60, 148);
  const iconMap={electrocucion:'⚡', quemadura:'🔥', ahogamiento:'🌊', aplastamiento:'🏚️'};
  ctx.font='72px sans-serif'; ctx.fillText(iconMap[escenarioKey]||'🛡️', W/2-36, 230);
  ctx.fillStyle='#1B2A4A'; ctx.font='900 38px sans-serif'; ctx.textAlign='center'; ctx.fillText('DIPLOMA DE RECONOCIMIENTO', W/2, 285);
  ctx.textAlign='left';
  ctx.fillStyle='#5A6472'; ctx.font='600 16px sans-serif'; ctx.fillText('Otorgado al grupo:', 60, 340);
  ctx.fillStyle='#1B2A4A'; ctx.font='900 44px sans-serif'; ctx.fillText(groupName, 60, 390);
  ctx.fillStyle='#1B2A4A'; ctx.font='600 18px sans-serif';
  ctx.fillText('Escenario superado: '+escenarioName, 60, 440);
  ctx.fillText('Puntaje obtenido: '+score+' / 100', 60, 475);
  ctx.fillText('Tiempo de respuesta: '+timeStr, 60, 510);
  ctx.fillStyle='#5A6472'; ctx.font='500 15px sans-serif';
  ctx.fillText('Fecha: '+new Date().toLocaleDateString('es-AR')+' · Corrientes, Argentina', 60, 550);
  ctx.fillStyle='#00B7EB'; ctx.beginPath(); ctx.arc(W-160, H-180, 68, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle='white'; ctx.font='900 16px sans-serif'; ctx.textAlign='center'; ctx.fillText('BE SAFE', W-160, H-188); ctx.font='700 12px sans-serif'; ctx.fillText('2026', W-160, H-168);
  ctx.textAlign='left';
  ctx.strokeStyle='#1B2A4A'; ctx.lineWidth=1.5; ctx.beginPath(); ctx.moveTo(60, H-110); ctx.lineTo(360, H-110); ctx.stroke();
  ctx.fillStyle='#1B2A4A'; ctx.font='600 13px sans-serif'; ctx.fillText('Coordinación Académica', 60, H-85);
  ctx.fillText('Salud Ocupacional Litoral', 60, H-65);
  ctx.fillStyle='#8894A6'; ctx.font='500 11px sans-serif'; ctx.fillText('Este diploma acredita la participación y evaluación en el simulador inmersivo de respuesta a catástrofes ambientales.', 60, H-35);
  document.getElementById('diplomaModal').classList.add('active');
  setTimeout(()=>launchCelebration(isChampion), 180);
}
function closeDiploma(){document.getElementById('diplomaModal').classList.remove('active'); const c=document.getElementById('confettiCanvas'); if(c){c.classList.remove('active'); const ctx=c.getContext('2d'); ctx.clearRect(0,0,c.width,c.height);} if(confettiAnimId) cancelAnimationFrame(confettiAnimId);}
function downloadDiploma(){const canvas=document.getElementById('diplomaCanvas'); const link=document.createElement('a'); link.download='Diploma_BeSafe_'+(state.group||'grupo')+'_'+Date.now()+'.png'; link.href=canvas.toDataURL('image/png'); link.click();}

</script>
